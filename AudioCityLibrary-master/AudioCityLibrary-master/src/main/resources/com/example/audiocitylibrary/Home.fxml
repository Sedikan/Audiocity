<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1200.0" stylesheets="@styles/lightMode.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.audiocitylibrary.Controllers">
    <top>
        <HBox alignment="CENTER" spacing="10" styleClass="top-menu" HBox.hgrow="ALWAYS">
            <ImageView fx:id="logoIcon" fitHeight="50" fitWidth="50" preserveRatio="true" styleClass="toolbar-logo">
                <image>
                    <Image url="@/minilogojasne.png" />
                </image>
            </ImageView>
            <Button fx:id="homeButton" mnemonicParsing="false" onAction="#go_to_Lib" styleClass="top-menu-button" text="Home" />
            <Button fx:id="songButton" mnemonicParsing="false" onAction="#addSong" styleClass="top-menu-button" text="Add song" />
            <Button fx:id="shopButton" mnemonicParsing="false" onAction="#openShop" styleClass="top-menu-button" text="Shop" />
            <Button fx:id="userButton" mnemonicParsing="false" onAction="#openUser" styleClass="top-menu-button" text="User" />
            <Button fx:id="settingsButton" mnemonicParsing="false" onAction="#settings" styleClass="top-menu-button" text="Settings" />
            <Pane HBox.hgrow="ALWAYS" />
            <Label prefHeight="41.0" prefWidth="81.0" text="Hello" textFill="WHITE">
                <font>
                    <Font size="23.0" />
                </font>
            </Label>
            <Label fx:id="usernameDisplay" prefHeight="41.0" prefWidth="390.0" text="$controller.UsersName" textFill="WHITE">
                <font>
                    <Font size="23.0" />
                </font>
            </Label>
        </HBox>
    </top>
    <center>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <ScrollPane>
                    <content>
                        <HBox fx:id="buttonContainer" prefHeight="380" spacing="10.0">
                            <padding>
                                <Insets left="10.0" right="10.0" top="40.0" />
                            </padding>
                        </HBox>
                    </content>
                    <!-- Remove the unnecessary hbarPolicy and vbarPolicy comments -->
                </ScrollPane>
            <ScrollPane layoutX="10.0" layoutY="10.0">
               <content>
                  <HBox fx:id="buttonContainer1" prefHeight="380" spacing="10.0">
                     <padding>
                        <Insets left="10.0" right="10.0" top="40.0" />
                     </padding>
                  </HBox>
               </content>
            </ScrollPane>
            </children>
        </VBox>
    </center>
</BorderPane>
