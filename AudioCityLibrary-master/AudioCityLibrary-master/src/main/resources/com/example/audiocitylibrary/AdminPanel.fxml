<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20" styleClass="admin-panel" stylesheets="/lightStyle.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.audiocitylibrary.AdminPanelController">

    <!-- TableView -->
    <TableView fx:id="userTable" prefHeight="400.0" prefWidth="802.0">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="100" text="ID Użytkownika" />
            <TableColumn fx:id="loginColumn" prefWidth="100" text="Login" />
            <TableColumn fx:id="passwordColumn" prefWidth="100" text="Hasło" />
            <TableColumn fx:id="permissionsColumn" prefWidth="100" text="Uprawnienia" />
            <TableColumn fx:id="saldoColumn" prefWidth="100" text="Saldo" />
            <TableColumn fx:id="emailColumn" prefWidth="100" text="Email" />
            <TableColumn fx:id="addressColumn" prefWidth="100" text="Adres" />
            <TableColumn fx:id="firstColumn" prefWidth="100" text="Czy Pierwszy?" />
        </columns>
    </TableView>


    <HBox spacing="10" alignment="CENTER">
        <Button onAction="#handlePromoteButtonAction" text="Awansuj" />
        <Button onAction="#handleDemoteButtonAction" text="Degraduj" />
        <Button onAction="#handleResignButtonAction" text="Zrezygnuj" />

    </HBox>

</VBox>
