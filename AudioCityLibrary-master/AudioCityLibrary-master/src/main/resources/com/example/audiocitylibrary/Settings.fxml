<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane fx:id="settingsGridPane" prefHeight="500.0" prefWidth="580.0" style="-fx-font-size: 18; -fx-padding: 20; -fx-line-spacing: 10;" stylesheets="/lightStyle.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.audiocitylibrary.Controllers">
    <HBox alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="0" />

    <!-- Custom Icon -->
    <Label text="CUSTOM ICON" GridPane.columnIndex="0" GridPane.rowIndex="1" textFill="WHITE" style="-fx-font-size: 24;">
        <padding>
            <Insets bottom="20.0" top="20.0" />
        </padding></Label>
    <TextField fx:id="iconPathTextField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    <Button onAction="#browseIcon" text="Browse" GridPane.columnIndex="2" GridPane.rowIndex="1" />
    <HBox alignment="CENTER_LEFT" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3" />

    <!-- Przycisk do zapisywania ustawień -->
    <Button onAction="#saveSettings" text="Zapisz Ustawienia" GridPane.columnSpan="2" GridPane.rowIndex="6" />
    <Button mnemonicParsing="false" onAction="#browseIcon" text="Browse" GridPane.columnIndex="2" GridPane.rowIndex="1" />
    <Button fx:id="panelAdministratoraButton" mnemonicParsing="false" onAction="#openAdminPanel" text="Panel Administratora" GridPane.rowIndex="5" />
    <columnConstraints>
        <ColumnConstraints />
        <ColumnConstraints />
        <ColumnConstraints />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
    </rowConstraints>
    <padding>
        <Insets bottom="30.0" top="30.0" />
    </padding>
    <GridPane.margin>
        <Insets bottom="10.0" top="10.0" />
    </GridPane.margin>
</GridPane>
