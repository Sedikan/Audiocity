<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="main-background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.audiocitylibrary.LoginController">
   <children>
      <AnchorPane prefHeight="519.0" prefWidth="521.0">
         <AnchorPane prefHeight="650.0" prefWidth="502.0">

            <AnchorPane fx:id="logowanko" layoutX="8.0" layoutY="40.0" prefHeight="400.0" prefWidth="300.0">
               <VBox alignment="CENTER" prefHeight="450.0" prefWidth="599.0">
                  <Label styleClass="title-label" text="AUDIOTOWN" />
                  <Label styleClass="subtitle-label" text="Music for everyone" />
                  <VBox alignment="CENTER_LEFT" prefHeight="114.0" prefWidth="631.0" spacing="10">
                     <Label styleClass="field-label" text="Username:" />
                     <TextField fx:id="login_text_id" onAction="#login_text" prefHeight="25.0" prefWidth="614.0" promptText="Enter username" styleClass="text-field" />
                     <Label styleClass="field-label" text="Password:" />
                     <PasswordField fx:id="passwd_text_id" onAction="#passwd_text" prefHeight="25.0" prefWidth="618.0" promptText="Enter password" styleClass="text-field" />
                  </VBox>
                  <HBox alignment="CENTER" spacing="10">
                     <Button fx:id="login_btn_id" mnemonicParsing="false" onAction="#loginUser" styleClass="button" text="LOGIN" />
                     <Button fx:id="go_to_register_btn_id" mnemonicParsing="false" onAction="#go_to_register" styleClass="button" text="SIGN UP" />
                     <Button fx:id="regulamin_btn_id" mnemonicParsing="false" onAction="#regulamin_show" styleClass="button" text="RULES" />
                  </HBox>
               </VBox>
            </AnchorPane>
            <AnchorPane fx:id="register" layoutX="300.0" layoutY="50.0" prefHeight="400.0" prefWidth="300.0" visible="false">
               <children>
                  <VBox alignment="CENTER" layoutX="50.0" layoutY="14.0" prefWidth="200.0" spacing="10">
                     <Label styleClass="title-label" text="Sign Up" />
                     <VBox alignment="CENTER_LEFT" prefWidth="300" spacing="5">
                        <Label styleClass="field-label" text="Username:" textFill="WHITE" />
                        <TextField fx:id="register_login_text_id" promptText="Enter username" styleClass="text-field" />
                        <Label styleClass="field-label" text="Password:" textFill="#f5f5f5" />
                        <PasswordField fx:id="register_passwd_text_id" promptText="Enter password" styleClass="text-field" />
                        <Label styleClass="field-label" text="E-mail:" textFill="WHITE" />
                        <TextField fx:id="register_email_text_id" promptText="Enter email" styleClass="text-field" />
                        <Label styleClass="field-label" text="Address:" textFill="WHITE" />
                        <TextField fx:id="register_adress_text_id" promptText="Enter address" styleClass="text-field" />
                     </VBox>
                     <HBox alignment="CENTER" spacing="10">
                        <Button fx:id="register_btn_id" onAction="#registerUser" styleClass="button" text="SIGN UP" />
                        <Button fx:id="regulamin_btn_id1" onAction="#regulamin_show" styleClass="button" text="RULES" />
                     </HBox>
                  </VBox>
               </children>
            </AnchorPane>
         </AnchorPane>
      </AnchorPane>
   </children>
</StackPane>